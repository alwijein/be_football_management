# ========================================
# Football Management API - Configuration
# ========================================
# 
# Copy this file to .env and update with your actual values
# 
# ⚠️ IMPORTANT: Never commit .env to version control!
# ========================================

# ========================================
# DATABASE CONFIGURATION (MySQL)
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=football_db

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080

# GIN_MODE options:
# - debug: Development mode (verbose logging)
# - release: Production mode (optimized performance)
# - test: Testing mode
GIN_MODE=debug

# ========================================
# JWT AUTHENTICATION
# ========================================
# IMPORTANT: Use a strong, random secret key in production!
# Recommended: Minimum 32 characters
# Generate: openssl rand -base64 32
JWT_SECRET=your-very-secret-key-please-change-in-production-12345
JWT_EXPIRATION_HOURS=24

# ========================================
# APPLICATION INFO
# ========================================
APP_NAME=Football Management API
APP_VERSION=1.0.0

# ========================================
# OPTIONAL: FILE UPLOAD SETTINGS
# ========================================
# MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
# UPLOAD_PATH=./uploads

# ========================================
# OPTIONAL: CORS SETTINGS
# ========================================
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# ALLOWED_HEADERS=Content-Type,Authorization

# ========================================
# OPTIONAL: LOGGING
# ========================================
# LOG_LEVEL=debug
# LOG_FILE=./logs/app.log
