# ========================================
# Football Management API - .gitignore
# ========================================

# ========================================
# Go Binaries and Build Artifacts
# ========================================
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Go coverage files
*.out
*.prof

# Compiled Object files
*.o
*.a

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

# Build directory
bin/
build/
dist/

# ========================================
# Go Modules and Dependencies
# ========================================
vendor/
go.work
go.work.sum

# ========================================
# Environment and Configuration
# ========================================
# Environment variables (NEVER commit!)
.env
.env.local
.env.development
.env.production
.env.test

# Local configuration overrides
config.local.yml
config.local.json

# ========================================
# IDE and Editor Files
# ========================================
# Visual Studio Code
.vscode/
.vscode-test/
*.code-workspace

# GoLand / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~
.*.sw[a-z]
*.un~
Session.vim

# Emacs
*~
\#*\#
.\#*
.*.elc

# Atom
.atom/

# ========================================
# Operating System Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ========================================
# Logs and Temporary Files
# ========================================
# Log files
*.log
*.log.*
logs/
log/
*.bak
*.tmp

# Application logs
app.log
server.log
error.log
debug.log
access.log

# Crash logs
crash.log
panic.log

# ========================================
# Database Files
# ========================================
# SQLite databases
*.db
*.sqlite
*.sqlite3

# MySQL dumps
*.sql
*.sql.gz

# Database backups
db_backup/
database_backup/

# ========================================
# File Uploads (Local Development)
# ========================================
# Uncomment if you don't want to track uploaded files
# uploads/
# uploads/teams/*
# uploads/players/*
# uploads/profiles/*

# Keep directory structure but ignore files
uploads/**/*
!uploads/**/.gitkeep

# ========================================
# Testing and Coverage
# ========================================
# Test results
test-results/
coverage/
*.coverage
coverage.txt
coverage.html
coverage.out

# Benchmark results
*.bench
benchmark/

# ========================================
# Dependencies and Cache
# ========================================
# Go module cache
*.sum.bak
go.sum.bak

# NPM (if using any frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ========================================
# Docker
# ========================================
# Docker volumes
docker-compose.override.yml
.dockerignore

# ========================================
# CI/CD
# ========================================
# GitHub Actions artifacts
.github/workflows/artifacts/

# ========================================
# Security and Secrets
# ========================================
# Private keys
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# JWT secrets
jwt_secret.txt
secrets.yml
secrets.json

# AWS credentials
.aws/

# ========================================
# Documentation (if autogenerated)
# ========================================
# Swagger/OpenAPI autogenerated
docs/swagger/
api/swagger/

# ========================================
# Miscellaneous
# ========================================
# Temporary files
tmp/
temp/
*.tmp

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Backup files
*.backup
*.bk
*.old

# Debug files
debug/
__debug_bin

# Air (Go live reload)
tmp/
.air.toml

# ========================================
# Project Specific
# ========================================
# Custom ignore patterns
# Add your project-specific patterns below

# Compiled binaries
main
main.exe
football-api
football-api.exe

# Development database
football_db_dev.sql
test_data.sql
